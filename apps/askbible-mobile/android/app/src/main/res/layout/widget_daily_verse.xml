<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews：TextView / ImageView / LinearLayout / FrameLayout / ViewFlipper。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_parchment_scroll_bg" />

    <FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <ViewFlipper
            android:id="@+id/widget_verse_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="false"
            android:inAnimation="@anim/widget_verse_fade_in"
            android:outAnimation="@anim/widget_verse_fade_out">

            <FrameLayout
                android:id="@+id/widget_panel_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/widget_verse_line_0"
                    style="@style/WidgetVerseText"
                    android:layout_gravity="top|start" />

                <TextView
                    android:id="@+id/widget_verse_ref_0"
                    style="@style/WidgetRefText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_weight="0"
                    android:gravity="end" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_panel_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/widget_verse_line_1"
                    style="@style/WidgetVerseText"
                    android:layout_gravity="top|start" />

                <TextView
                    android:id="@+id/widget_verse_ref_1"
                    style="@style/WidgetRefText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_weight="0"
                    android:gravity="end" />
            </FrameLayout>
        </ViewFlipper>

        <LinearLayout
            android:id="@+id/widget_verse_audio_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_verse_music_toggle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/widget_audio_music_desc"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_audio_music" />

            <ImageView
                android:id="@+id/widget_verse_reading_toggle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/widget_audio_reading_desc"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_audio_voice" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
