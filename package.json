{
  "name": "selah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "node scripts/write-next-devtools-config.mjs && next dev --turbopack -p 3450",
    "dev:hot": "node scripts/write-next-devtools-config.mjs && next dev --turbopack -p 3450",
    "dev:webpack": "npm run clean && node scripts/write-next-devtools-config.mjs && next dev -p 3450",
    "dev:fresh": "npm run clean && node scripts/write-next-devtools-config.mjs && next dev --turbopack -p 3450",
    "free-port": "node scripts/free-port.mjs",
    "dev:restart": "node scripts/free-port.mjs 3450 && npm run dev:fresh",
    "check": "tsc --noEmit && npm run build",
    "dev:any": "node scripts/write-next-devtools-config.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "nature:backfill-preview-frames": "node scripts/backfill-nature-preview-frames.mjs",
    "import:bible": "node scripts/import-askbible-usfx.mjs",
    "ship": "bash scripts/ship.sh",
    "ship:data": "bash scripts/ship-data-config.sh",
    "mobile:start": "npm run start --prefix apps/selah-mobile",
    "mobile:ios": "npm run ios --prefix apps/selah-mobile",
    "mobile:android": "npm run android --prefix apps/selah-mobile",
    "dev:open": "bash scripts/launchers/run-dev-open-tabs.sh dev",
    "dev:restart:open": "bash scripts/launchers/run-dev-open-tabs.sh restart"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
