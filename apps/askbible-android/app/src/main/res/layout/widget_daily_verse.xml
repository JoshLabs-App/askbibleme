<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5EFE4"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_open_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#D97707"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="凡自高的，必降为卑；自卑的，必升为高。"
        android:textColor="#1C1410"
        android:textSize="14.5sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="1.48"
        android:gravity="top|start"
        android:ellipsize="end"
        android:maxLines="8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_reference"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="马太福音 23:12"
            android:textColor="#8A5A1E"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AskBible.me"
            android:textColor="#8A1C1410"
            android:textSize="10sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
