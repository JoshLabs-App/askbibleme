{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MOBILE_BUNDLED_ONLY": "1",
        "EXPO_PUBLIC_ASKBIBLE_BASE_URL": "https://askbible.me"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_MOBILE_BUNDLED_ONLY": "1",
        "EXPO_PUBLIC_ASKBIBLE_BASE_URL": "https://askbible.me"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
