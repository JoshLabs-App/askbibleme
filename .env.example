# --- AI：OpenAI 兼容 chat/completions（Ollama / LM Studio / 云网关均可）---
# 可选：部署时的缺省端点与模型（Studio 里「当前表单」优先）
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2
# 可选：Bearer Token（云上 API Key 等）；本地 Ollama 常可不设
# AI_API_KEY=
# 或 AI_BEARER_TOKEN=
# 兼容旧名：
# OPENAI_API_KEY=
# ESV_API_KEY=
# 或在后台「系统 → API 密钥」写入 data/admin/ai-api-config.json（按 URL / Studio 连接 id 自动注入）

# --- 快捷码扩展（Studio 输入 SKY 等并点「应用」）---
# AI_PRESET_SKY_NAME=Sky 网关
# AI_PRESET_SKY_BASE_URL=https://api.example.com/v1
# AI_PRESET_SKY_MODEL=
# AI_PRESET_SKY_API_KEY=
# 设为 1 时：应用快捷码后自动从该地址拉取并导入全部模型连接
# AI_PRESET_SKY_AUTO_SCAN=1

# --- Studio：保存时写回仓库 docs/*.md ---
# next dev 下默认允许（可用 STUDIO_DISABLE_DISK_SAVE=1 关闭）
# STUDIO_DISABLE_DISK_SAVE=1
# next start 等：需 STUDIO_ALLOW_DISK_SAVE=1 与 STUDIO_WRITE_SECRET；Studio 页内「可选」密钥框填同一值
# STUDIO_ALLOW_DISK_SAVE=1
# STUDIO_WRITE_SECRET=本地随机长字符串

# --- 音乐后台 /api/music/upload（可选）---
# MUSIC_UPLOAD_SKIP_ANALYSIS=1
# 默认不转码（保存原文件）；如需转码为 m4a 设为 0
# MUSIC_UPLOAD_SKIP_TRANSCODE=0
# 自然背景视频上传：不设则在本机用 ffmpeg 从母片生成 720p / 1080p H.264；设为 1 则只保存原文件（旧行为）
# NATURE_UPLOAD_SKIP_TRANSCODE=1
# 能量分析只解码前 N 秒（默认 120，范围 30–900）
# MUSIC_UPLOAD_ANALYSIS_MAX_SEC=120

# --- 公网「可编辑 / 管理」表面（/admin、/studio 及 /api/admin、/api/studio）---
# Vercel Production（VERCEL_ENV=production）下中间件对这些路径默认返回 404，与本机优先约定一致：
# /admin、/studio、/api/admin、/api/studio、/api/ai（含 chat / preset / local-models）。
# 临时在线上打开（不推荐）：SELAH_ALLOW_ADMIN_IN_PRODUCTION=1
# 任意非 development 环境强制关闭（如自托管生产）：SELAH_DISABLE_PUBLIC_ADMIN=1

# --- 管理后台：本地开发免登录（默认）---
# next dev 下 /admin 默认不要求邮箱或口令；若要本地仍测登录流程：
# ADMIN_REQUIRE_LOGIN=1

# --- 管理后台：复用 AskBible 2 账号（可选）---
# 若部署机能访问到旧站 auth.sqlite，登录页优先用「邮箱 + 密码」与旧站一致（is_admin=1）。
# 生产（如 Vercel）请设绝对路径或相对仓库根的路径，勿依赖本机桌面默认路径：
# ASKBIBLE_AUTH_SQLITE_PATH=/var/data/admin_data/auth.sqlite
# 或指向老仓库：ASKBIBLE_REPO=/path/to/01 AskBible 2
# 会话 cookie 用与 ADMIN_GATE_SECRET 相同的密钥签名；勿泄露 Secret。
# 前台用户认证默认使用本地 sqlite（与旧站同库）；建议设置 DATA_ROOT 并持久化到 Render 磁盘。
#
# --- 会员认证：共享 Supabase（与 JoshMoney 同项目 josh-apps）---
# 设齐下列三项后，Web / 移动端会员登录走 Supabase；未设则回退 auth.sqlite。
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 仅服务端：删号、用户迁移脚本
# 一次性导入旧用户：npm run migrate:askbible-users-to-supabase
#
# --- Google 登录（Supabase Auth）---
# 1) Supabase Dashboard → Authentication → Providers → Google：填入 Google Cloud OAuth Web client ID/secret
# 2) Supabase → Authentication → URL Configuration → Redirect URLs 增加：
#    https://askbible.me/auth/callback
#    http://localhost:3450/auth/callback
# 3) App 原生 Google Sign-In（与 Supabase 使用同一 Web client ID）：
#    EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
#    EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com   # iOS OAuth client（可选但推荐）
#    EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.123456789-xxxx # 供 app.config.js 注入原生插件
#    设 EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME 后需重新本机构建 iOS/Android（npm run mobile:build:ios:production 等）
#
# --- Apple 登录（Supabase Auth）---
# 1) Apple Developer → Identifiers → 你的 App ID (me.askbible) → 启用 Sign In with Apple
# 2) Supabase Dashboard → Authentication → Providers → Apple → Client IDs（逗号分隔，都要登记）：
#    - iOS 原生登录必填：me.askbible（与 app.json bundleIdentifier 一致；id_token 的 aud 即此值）
#    - Web OAuth 另填：你的 Services ID（如 me.askbible.service）
#    若只配了 Services ID 而未配 Bundle ID，App 会报：
#    unacceptable audience in id_token:[me.askbible]
# 3) Secret Key 等 OAuth 字段仅 Web 跳转登录需要；纯原生 iOS 可不填
# 3) Redirect URLs 与 Google 相同：
#    https://askbible.me/auth/callback
#    http://localhost:3450/auth/callback
# 4) App iOS：`expo-apple-authentication` 已在 app.config.js 启用 `usesAppleSignIn`
#    改原生能力后需重新本机构建 iOS（npm run mobile:build:ios:production）

# --- 旧站 HTTP 登录（推荐线上：无需在 Vercel 挂载 sqlite）---
# AskBible 服务端 POST JSON 到旧站，由旧站校验密码；成功则 AskBible 签发本站 HttpOnly cookie（不在 AskBible 内重算 bcrypt）。
# 请求体：{ "email", "password", "purpose": "user" | "admin" }（旧站可忽略 purpose）。
# 成功响应（其一即可）：{ "ok": true, "id", "email", "name"? } 或 { "ok": true, "user": { "id", "email", "name"? } }
# 管理端同一 URL 时须含管理员标记之一：isAdmin / admin / is_admin:1 / role:"admin" / roles 含 "admin"。
# 可选请求头：ASKBIBLE_LEGACY_LOGIN_BEARER → Authorization；ASKBIBLE_LEGACY_LOGIN_SECRET → X-Selah-Auth
# ASKBIBLE_LEGACY_USER_LOGIN_URL=https://旧域名/.../selah-login
# ASKBIBLE_LEGACY_ADMIN_LOGIN_URL=https://旧域名/.../selah-admin-login
# 若用户与后台共用同一端点，只设其一即可：
# ASKBIBLE_LEGACY_LOGIN_URL=https://旧域名/.../selah-login
#
# 首次上线会员库到 Render 盘（SSH 目标以控制台为准）：
# AUTH_SQLITE_REMOTE_SCP_TARGET='srv-xxx@ssh.oregon.render.com:/var/data/admin_data/auth.sqlite' npm run auth:push-remote
#
# 会员注册（Web + 移动端 API）：
# 服务端开关（/api/mobile/auth/register、/api/auth/askbible?action=register）
MEMBER_REGISTER_ENABLED=1
# 前端是否展示注册入口（Web 登录页 / 侧栏）
NEXT_PUBLIC_MEMBER_REGISTER_ENABLED=1
# App 内注册入口与联网注册请求
# EXPO_PUBLIC_MEMBER_REGISTER_ENABLED=1
# 移动端 App 发布默认联网（本机 Release 脚本 / eas.json production profile 已设；开发时可显式写 0）
# EXPO_PUBLIC_MOBILE_OFFLINE_FIRST=0
# EXPO_PUBLIC_MOBILE_BUNDLED_ONLY=0
# TEMPORARY：金句语音 R2 直链（默认开）。基址无尾斜杠，对象在 /audio/golden-verses/…
# EXPO_PUBLIC_GOLDEN_VERSE_AUDIO_BASE_URL=https://pub-xxxx.r2.dev
# EXPO_PUBLIC_GOLDEN_VERSE_AUDIO_STREAM=0
# TEMPORARY：非专辑首曲音乐 R2（默认开）。对象键 music/uploads/…（可与金句同 pub 基址）
# EXPO_PUBLIC_MUSIC_AUDIO_BASE_URL=https://pub-xxxx.r2.dev
# EXPO_PUBLIC_MUSIC_AUDIO_STREAM=0
#
# 移动端远程内容基础设施（manifest + flags）：
# MOBILE_REMOTE_CONTENT_MANIFEST_ENABLED=1
# MOBILE_EXPLORE_CATEGORIES_REMOTE_ENABLED=1
# App Store / Play 提交密钥路径（本机或 CI）：
# ASC_API_KEY_PATH=/absolute/path/AuthKey_xxx.p8
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/google-play-service-account.json

# 产品使用统计：默认与信息版同盘（dev → data/bible/telemetry-v1-store.json；Render → DATA_ROOT 下同名文件）。
# 关闭采集（可选）：
# NEXT_PUBLIC_TELEMETRY_DISABLED=1
# EXPO_PUBLIC_TELEMETRY_DISABLED=1
# 首次打开首屏提示（默认开启；设为 0 可关闭）
# NEXT_PUBLIC_FIRST_OPEN_HINT_ENABLED=1
# EXPO_PUBLIC_FIRST_OPEN_HINT_ENABLED=1
# 网页 App 安装引导（/install 引导页 + 探索页安装卡片）
# NEXT_PUBLIC_APP_INSTALL_IOS_URL=https://apps.apple.com/app/id6771996188
# NEXT_PUBLIC_APP_INSTALL_ANDROID_EMAIL=support@askbible.me
# （也可复用 NEXT_PUBLIC_FEEDBACK_EMAIL 作为 Android 试用申请收件邮箱）
#
# 用户反馈（/feedback + /api/feedback）：
# 开发环境默认写 data/feedback/feedback-submissions.jsonl；
# 生产建议配置 DATA_ROOT（或单独 FEEDBACK_DATA_DIR）。
# 反馈与内容纠错均写入挂载盘：feedback/feedback-submissions.jsonl、content-corrections/content-corrections.jsonl
# 登录会员读经进度同步（/api/member/reading-sync，App 与 Web 共用）：默认 DATA_ROOT/member-reading-sync/{userId}.json
# MEMBER_READING_SYNC_DATA_DIR=/var/data
# FEEDBACK_DATA_DIR=/var/data
# 可选：页面显示备用邮箱入口
# NEXT_PUBLIC_FEEDBACK_EMAIL=support@askbible.me
# 可选：提交后邮件通知（Resend）
# FEEDBACK_NOTIFY_EMAIL=you@example.com
# FEEDBACK_FROM_EMAIL=AskBible Feedback <noreply@askbible.me>
# RESEND_API_KEY=re_xxx
# 读经页「信息版」按需生成（二选一）：
#
# A) Render Persistent Disk（askbible.me 推荐磁盘方案）：
#    1. Render 控制台 → Web Service → Disks → Mount Path 须与 DATA_ROOT 完全一致（本仓库常用 /var/data）
#    2. 保存后 Manual Deploy（新盘须重启实例才挂载）
#    3. Environment（Production）：
# INFO_EDITION_DISK_SAVE=1
# DATA_ROOT=/var/data
#    可选别名：INFO_EDITION_DATA_DIR=/var/data
#    写入文件：<挂载根>/info-edition-v1-published.json（勿再建 bible 子目录）
#    Git 提交发布后同步到盘：DATA_ROOT=/var/data npm run info-edition:sync-disk
#    或仅提交 data 配置：npm run ship:data -- "chore: 更新信息版发布"
#    线上临时全本批量（Render 后台启停，直写 DATA_ROOT，跑完关闭）：
# INFO_EDITION_BATCH_ONLINE=1
#    管理页：/admin/read/info-edition-batch · API：/api/admin/bible/info-edition-batch
#    跑完后设 INFO_EDITION_BATCH_ONLINE=0（或删除）并 Manual Deploy。
#    本机全本批量（逐章落盘 + 断点 + 可选每卷 scp）：npm run info-edition:batch
#    仅重生成校验未通过章节：npm run info-edition:batch:fix-invalid
#    输出 token（默认讲解 4096 / 发现 6144，防截断缺「经文回应」等模块）：
# INFO_EDITION_READER_MAX_TOKENS_INFO=4096
# INFO_EDITION_READER_MAX_TOKENS_GUIDE=6144
#    校验失败自动重试次数（默认 2，即最多 3 次生成）：INFO_EDITION_BATCH_VALIDATE_RETRIES=2
#    进度页（dev）：http://localhost:3450/dev/info-edition-batch
#    INFO_EDITION_REMOTE_SCP_TARGET='user@ssh.render.com:/var/data/info-edition-v1-published.json' npm run info-edition:push-remote
#    4. 同一页还需 AI（见下）
#
# WEB / BBE 整章朗读（与 web-en 正文对齐；bbe-en 共用 web-en 音轨）：
#   npm run audio:web-en-manifest && npm run audio:web-en-pull
#   npm run audio:web-en-timings -- --book MAT --chapter 1
#   npm run audio:web-en-timings -- --all
# 路径：public/audio/web-en/{BOOK}-{章}.mp3 ；逐节：public/verse-timings/web-en/
# 默认：Web 经文朗读对接原始公开站点（FHL / theaudiopower / ebible / TSTSCC），无需 Render 同步 MP3。
# 仅当你要强制只用本站 /audio/* 时才开启自托管：
# NEXT_PUBLIC_WEB_CHAPTER_AUDIO_SELF_HOSTED=1
# NEXT_PUBLIC_CUV_CHAPTER_AUDIO_SELF_HOSTED=1
#
# 自托管音源路径：public/audio/web-en|blm-es|cuv-v20/*.mp3 或磁盘 {DATA_ROOT}/audio/...
# （可选）Render 分批直下到磁盘：
#   DATA_ROOT=/var/data CUV_AUDIO_BATCH_INDEX=0 npm run audio:pull-batch   # 每批约 80 章，共 15 批
#   DATA_ROOT=/var/data npm run audio:pull-all-batches                      # 一次跑完全部
# 自定义目录（默认 cuv-v20）：CUV_AUDIO_LOCAL_SUBDIR=cuv-v20
# 如需强制刷新为最新版来源：CUV_AUDIO_FORCE_OVERWRITE=1 DATA_ROOT=/var/data npm run audio:pull-all-batches
# 大文件入 Git 建议 Git LFS：git lfs track "public/audio/*.mp3"
#
# 和合本逐节跟读时间轴（AskBible Whisper 对齐，约 4.7MB / 1189 章）：
#   npm run audio:verse-timings-sync   # 从 AskBible 2 复制到 public/verse-timings/
#
# 潮州语新约朗读（眾生命堂 TSTSCC 朗读版，约 260 章 ~692MB；manifest 已入库）：
# 生产：磁盘无 MP3 时 /audio/teochew-nt/* 会代理 GitHub 分支 teochew-nt-audio（可选 TEOCHEW_AUDIO_GIT_REF / GITHUB_TOKEN）。
#   npm run audio:teochew-manifest   # 从源站刷新 URL 清单（一般不必重复）
#   npm run audio:teochew-pull      # 下载到 public/audio/teochew-nt/ 或 DATA_ROOT/audio/teochew-nt/
# Render 磁盘（无需本机上传，从 TSTSCC 分批直下到 /var/data/audio/teochew-nt/）：
#   DATA_ROOT=/var/data npm run audio:teochew-pull-all-batches
# 本机已有 MP3 时推到 Render（需 SSH）：
#   TEOCHEW_AUDIO_REMOTE_RSYNC_TARGET='user@ssh.render.com:/var/data/audio/teochew-nt/' npm run audio:teochew-push-remote
# 或 Git 分支 teochew-nt-audio（与 cuv-chapter-audio 同思路）：
#   npm run audio:teochew-checkout && DATA_ROOT=/var/data npm run audio:teochew-sync-disk
#   DATA_ROOT=/var/data TEOCHEW_AUDIO_SOURCE=github npm run audio:teochew-pull-all-batches
#   npm run audio:teochew-timings -- --book MAT --chapter 1   # Whisper 对齐 → public/verse-timings/teochew-nt/
#   （需 AskBible 2 的 scripts/whisper-env 或本仓库 scripts/whisper-env + stable-ts）
#
# B) 无磁盘场景不再支持（请改用 Render Persistent Disk）
# 生产 DeepSeek（若未提交 data/admin/ai-api-config.json）：
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_API_KEY=sk-...
# 仅以下邮箱可进 /admin（逗号分隔，不区分大小写）：
# ADMIN_USER_EMAILS=you@example.com,coworker@example.com
# 从老站「01 AskBible 2」导出管理员邮箱（本机需有 sqlite3 命令行）：
# npm run migrate:askbible-admin-emails
# 或 ASKBIBLE_REPO=/绝对路径/01 AskBible 2 node scripts/migration/askbible-admin-export.mjs

# 主页经文池（方案 B：内置 ge5 + 受签名远程切换）
# 仅当配置此公钥后，客户端才会尝试读取并验签：
# /data/home-prayer-pools/pool-config.signed.json
# NEXT_PUBLIC_HOME_PRAYER_POOL_CONFIG_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
