{
  "name": "askbible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "prebuild": "node scripts/write-app-build-meta.mjs && node node_modules/tsx/dist/cli.mjs scripts/build-bible-sqlite-from-json.ts",
    "dev": "node scripts/write-app-build-meta.mjs --dev && node scripts/write-next-devtools-config.mjs && next dev --turbopack -p 3450",
    "dev:hot": "node scripts/write-app-build-meta.mjs --dev && node scripts/write-next-devtools-config.mjs && next dev --turbopack -p 3450",
    "dev:webpack": "npm run clean && node scripts/write-app-build-meta.mjs --dev && node scripts/write-next-devtools-config.mjs && next dev -p 3450",
    "dev:fresh": "npm run clean && node scripts/write-app-build-meta.mjs --dev && node scripts/write-next-devtools-config.mjs && next dev --turbopack -p 3450",
    "free-port": "node scripts/free-port.mjs",
    "dev:restart": "node scripts/free-port.mjs 3450 && npm run dev:fresh",
    "check": "tsc --noEmit && npm run build",
    "dev:any": "node scripts/write-app-build-meta.mjs --dev && node scripts/write-next-devtools-config.mjs && next dev",
    "build": "next build",
    "render:build": "npm install --include=dev --no-audit --no-fund && npm run build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "nature:backfill-preview-frames": "tsx scripts/regenerate-nature-preview-frames.ts",
    "nature:regenerate-preview-4k": "tsx scripts/regenerate-nature-preview-frames.ts --force",
    "nature:backfill-square-thumbs": "tsx scripts/backfill-nature-square-thumbs.ts",
    "nature:regenerate-square-thumbs": "tsx scripts/backfill-nature-square-thumbs.ts --force",
    "nature:retranscode": "tsx scripts/retranscode-nature-videos.ts",
    "import:bible": "node scripts/import-askbible-usfx.mjs",
    "import:bible:public-domain-en": "node scripts/import-public-domain-usfx.mjs",
    "import:bible:open-bible": "node scripts/import-open-bible.mjs",
    "import:reader-verse-themes": "tsx scripts/import-reader-verse-themes.ts",
    "build:theme-repeat-pool": "tsx scripts/build-theme-repeat-pool.ts",
    "theme-repeat:allowlist": "tsx scripts/theme-repeat-pool-allowlist.ts",
    "theme-repeat:sign-config": "node scripts/sign-home-prayer-pool-config.mjs",
    "import:reading-plans": "tsx scripts/import-khornberg-reading-plans.ts",
    "build:speech-spans-v1": "tsx scripts/build-speech-spans-v1.ts",
    "build:speech-spans-v2": "tsx scripts/build-speech-spans-v2.ts",
    "build:speech-spans-review-queue": "tsx scripts/build-speech-spans-review-queue.ts",
    "build:speech-spans:auto-review": "tsx scripts/auto-review-speech-spans-v2.ts",
    "build:speech-spans:ai-gospels": "tsx scripts/build-speech-spans-ai-gospels.ts",
    "build:speech-spans:reset-gospels": "tsx scripts/reset-gospel-speech-overrides.ts",
    "build:bible-sqlite": "tsx scripts/build-bible-sqlite-from-json.ts",
    "build:scripture-xrefs": "tsx scripts/build-scripture-xrefs-sqlite.ts",
    "migrate:askbible-admin-emails": "node scripts/migration/askbible-admin-export.mjs",
    "audio:checkout": "bash scripts/checkout-cuv-chapter-audio.sh",
    "audio:restore": "bash scripts/checkout-cuv-chapter-audio.sh",
    "audio:sync-disk": "node scripts/sync-cuv-audio-to-data-root.mjs",
    "audio:deploy-disk": "npm run audio:restore && node scripts/sync-cuv-audio-to-data-root.mjs",
    "audio:pull-batch": "node scripts/pull-cuv-audio-batch-to-disk.mjs",
    "audio:pull-all-batches": "node scripts/pull-cuv-audio-all-batches.mjs",
    "audio:teochew-manifest": "node scripts/build-teochew-nt-manifest.mjs",
    "audio:teochew-pull": "node scripts/pull-teochew-nt-audio.mjs",
    "audio:teochew-checkout": "bash scripts/checkout-teochew-nt-audio.sh",
    "audio:teochew-sync-disk": "node scripts/sync-teochew-audio-to-data-root.mjs",
    "audio:teochew-deploy-disk": "bash scripts/checkout-teochew-nt-audio.sh && node scripts/sync-teochew-audio-to-data-root.mjs",
    "audio:teochew-push-remote": "node scripts/push-teochew-audio-remote.mjs",
    "audio:teochew-pull-batch": "node scripts/pull-teochew-audio-batch-to-disk.mjs",
    "audio:teochew-pull-all-batches": "node scripts/pull-teochew-audio-all-batches.mjs",
    "audio:hakka-manifest": "node scripts/build-hakka-audio-manifest.mjs",
    "audio:hakka-pull": "node scripts/pull-hakka-audio.mjs",
    "audio:hakka-pull-batch": "node scripts/pull-hakka-audio-batch-to-disk.mjs",
    "audio:hakka-pull-all-batches": "node scripts/pull-hakka-audio-all-batches.mjs",
    "audio:verse-timings-sync": "node scripts/sync-cuv-verse-timings.mjs",
    "audio:cuv-v20-timings": "node scripts/generate-cuv-v20-verse-timings.mjs",
    "audio:teochew-timings": "node scripts/generate-teochew-nt-verse-timings.mjs",
    "audio:web-en-manifest": "node scripts/build-web-en-audio-manifest.mjs",
    "audio:web-en-pull": "node scripts/pull-web-en-audio.mjs",
    "audio:blm-es-manifest": "node scripts/build-blm-es-audio-manifest.mjs",
    "audio:blm-es-pull": "node scripts/pull-blm-es-audio.mjs",
    "audio:web-en-timings": "node scripts/generate-web-en-verse-timings.mjs",
    "info-edition:sync-disk": "node scripts/sync-info-edition-published-to-data-root.mjs",
    "info-edition:batch": "NODE_ENV=development NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx scripts/batch-info-edition-volumes.ts",
    "info-edition:batch:genesis": "NODE_ENV=development INFO_EDITION_BATCH_BOOK_START=GEN INFO_EDITION_BATCH_BOOK_END=GEN INFO_EDITION_BATCH_EDITIONS=info,guide NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx scripts/batch-info-edition-volumes.ts",
    "info-edition:batch:fix-invalid": "NODE_ENV=development INFO_EDITION_BATCH_FIX_INVALID=1 INFO_EDITION_BATCH_EDITIONS=info,guide NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx scripts/batch-info-edition-volumes.ts",
    "info-edition:strip-guide-prayer": "NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx scripts/strip-info-edition-guide-prayer.ts",
    "info-edition:push-remote": "node scripts/push-info-edition-published-remote.mjs",
    "auth:sync-disk": "node scripts/sync-auth-sqlite-to-data-root.mjs",
    "auth:push-remote": "node scripts/push-auth-sqlite-remote.mjs",
    "ship": "bash scripts/ship.sh",
    "ship:data": "bash scripts/ship-data-config.sh",
    "tv:sync-content": "node scripts/sync-tv-content.mjs",
    "tv:package": "npm run tv:sync-content && npm run package --prefix apps/askbible-tv-webos",
    "mobile:sync-content": "node scripts/sync-mobile-content.mjs && node scripts/sync-mobile-verse-timings.mjs && node scripts/sync-mobile-chapter-audio.mjs && node scripts/sync-mobile-home-verse-pool.mjs && node scripts/generate-mobile-home-verse-chunk-registry.mjs && node scripts/sync-mobile-scripture-sqlite.mjs",
    "mobile:sync-chapter-audio": "MOBILE_BUNDLE_CHAPTER_AUDIO=1 node scripts/sync-mobile-chapter-audio.mjs",
    "mobile:pack-chapter-audio-manifest": "node scripts/build-mobile-chapter-audio-pack-manifest.mjs",
    "mobile:sync-icons": "tsx scripts/sync-mobile-app-icons.ts",
    "mobile:sync-android-icons": "node scripts/sync-android-launcher-icons.mjs",
    "mobile:sync-offline-media": "node scripts/sync-mobile-offline-media.mjs",
    "mobile:refresh-nature-bundle": "npm run mobile:sync-content && npm run mobile:sync-offline-media",
    "mobile:sync-home-verse-pool": "node scripts/sync-mobile-home-verse-pool.mjs && node scripts/generate-mobile-home-verse-chunk-registry.mjs",
    "mobile:sync-scripture": "node scripts/sync-mobile-scripture-sqlite.mjs",
    "mobile:release:preflight": "node scripts/mobile-release-preflight.mjs",
    "mobile:start": "npm run start --prefix apps/askbible-mobile",
    "mobile:metro": "npm run start --prefix apps/askbible-mobile",
    "mobile:api": "npm run dev",
    "mobile:ios": "npm run mobile:sync-content && npm run ios --prefix apps/askbible-mobile",
    "mobile:ios:device": "bash scripts/launchers/run-mobile-ios-device.sh",
    "mobile:ios:device:metro": "bash scripts/launchers/run-mobile-ios-device-metro.sh",
    "mobile:ios:standalone": "bash scripts/build-mobile-ios-device-standalone.sh",
    "mobile:android": "bash scripts/run-mobile-android.sh",
    "mobile:android:device": "bash scripts/launchers/run-mobile-android-device.sh",
    "mobile:android:restart": "bash scripts/launchers/restart-android-app.sh",
    "mobile:android:wifi": "bash scripts/launchers/reconnect-android-wifi.sh",
    "mobile:android:usb": "bash scripts/launchers/reconnect-android-usb-reverse.sh",
    "mobile:dev": "bash scripts/launchers/run-mobile-dev.sh ios",
    "mobile:dev:iphone": "bash scripts/launchers/run-mobile-ios-device.sh",
    "mobile:dev:android:device": "bash scripts/launchers/run-mobile-android-device.sh",
    "mobile:dev:metro": "npm run mobile:live",
    "mobile:live": "bash scripts/launchers/run-mobile-live-servers.sh",
    "mobile:dev:android": "bash scripts/launchers/run-mobile-dev.sh android",
    "mobile:install:apk:device": "bash scripts/launchers/install-mobile-apk-to-device.sh",
    "mobile:install:offline-apk": "bash scripts/launchers/install-mobile-apk-to-device.sh",
    "mobile:build:apk:local": "bash scripts/build-mobile-apk-local.sh",
    "mobile:build:apk": "npm run mobile:sync-content && npm run mobile:sync-offline-media && cd apps/askbible-mobile && eas build --profile preview --platform android",
    "mobile:build:android:production": "bash scripts/eas-build-android-production.sh",
    "mobile:submit:android:production": "bash scripts/eas-submit-android-production.sh",
    "mobile:submit:android:closed-testing": "bash scripts/eas-submit-android-closed-testing.sh",
    "mobile:build:ios:internal": "bash scripts/eas-build-ios-preview.sh",
    "mobile:build:ios:production": "bash scripts/eas-build-ios-production.sh",
    "mobile:submit:ios:production": "bash scripts/eas-submit-ios-production.sh",
    "mobile:update:preview": "bash scripts/eas-update-preview.sh",
    "dev:open": "bash scripts/launchers/run-dev-open-tabs.sh dev",
    "dev:restart:open": "bash scripts/launchers/run-dev-open-tabs.sh restart"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "next": "^15.3.0",
    "opencc-js": "^1.3.1",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eas-cli": "^16.28.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
