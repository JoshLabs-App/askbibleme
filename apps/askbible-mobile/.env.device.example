# 仅「6-手机开发-Android真机」等开发流程使用；Release 侧载包会忽略本文件。
# 真机调试：复制为 .env.local 并改成你 Mac 的局域网 IP（终端: ipconfig getifaddr en0）
# 同时在本机运行: npm run dev（网站 API 3450）与 npx expo start --lan（Metro 8081）
# iPhone USB-only 开发建议不配本地 IP，交给 `src/config/askbibleBaseUrl.ts` 自动回退到 https://askbible.me，保证可读数据。

EXPO_PUBLIC_ASKBIBLE_BASE_URL=http://192.168.1.100:3450

# 全局离线优先（默认 1）：为 1 时移动端不请求网站，只用本地打包资源
# 联调线上/本机 API 时临时改为 0
EXPO_PUBLIC_MOBILE_OFFLINE_FIRST=1

# 会员注册入口（默认关闭，待线上准备好后改为 1）
EXPO_PUBLIC_MEMBER_REGISTER_ENABLED=0
