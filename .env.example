# --- AI：OpenAI 兼容 chat/completions（Ollama / LM Studio / 云网关均可）---
# 可选：部署时的缺省端点与模型（Studio 里「当前表单」优先）
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2
# 可选：Bearer Token（云上 API Key 等）；本地 Ollama 常可不设
# AI_API_KEY=
# 或 AI_BEARER_TOKEN=
# 兼容旧名：
# OPENAI_API_KEY=

# --- 快捷码扩展（Studio 输入 SKY 等并点「应用」）---
# AI_PRESET_SKY_NAME=Sky 网关
# AI_PRESET_SKY_BASE_URL=https://api.example.com/v1
# AI_PRESET_SKY_MODEL=
# AI_PRESET_SKY_API_KEY=
# 设为 1 时：应用快捷码后自动从该地址拉取并导入全部模型连接
# AI_PRESET_SKY_AUTO_SCAN=1

# --- Studio：保存时写回仓库 docs/*.md ---
# next dev 下默认允许（可用 STUDIO_DISABLE_DISK_SAVE=1 关闭）
# STUDIO_DISABLE_DISK_SAVE=1
# next start 等：需 STUDIO_ALLOW_DISK_SAVE=1 与 STUDIO_WRITE_SECRET；Studio 页内「可选」密钥框填同一值
# STUDIO_ALLOW_DISK_SAVE=1
# STUDIO_WRITE_SECRET=本地随机长字符串
