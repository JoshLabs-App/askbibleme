{
  "name": "askbible",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "clean": "find .next/ -mindepth 1 -delete 2>/dev/null || rm -rf .next; rm -rf dist node_modules/.cache",
    "clean:temp": "node scripts/clean-temp.mjs",
    "map": "node scripts/gen-code-map.mjs",
    "sync:theme": "node node_modules/tsx/dist/cli.mjs scripts/sync-theme-tokens.mjs",
    "check:colors": "node node_modules/tsx/dist/cli.mjs scripts/sync-theme-tokens.mjs --check && node scripts/check-hardcoded-colors.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node scripts/write-app-build-meta.mjs && node scripts/sync-web-static-read-content.mjs && node node_modules/tsx/dist/cli.mjs scripts/build-bible-sqlite-from-json.ts && node node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.config-build.json scripts/build-static-scripture.ts && node node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.config-build.json scripts/build-static-xrefs.ts && node node_modules/tsx/dist/cli.mjs scripts/build-static-creed-bodies.ts && node node_modules/tsx/dist/cli.mjs tools/build-web-pack.mjs && node scripts/build-cf-static-assets.mjs",
    "web:sync-static-read": "node scripts/sync-web-static-read-content.mjs",
    "dev": "node scripts/write-app-build-meta.mjs --dev && node scripts/write-next-devtools-config.mjs && next dev --turbopack -p 3450",
    "dev:fresh": "npm run clean && npm run dev",
    "free-port": "node scripts/free-port.mjs",
    "dev:restart": "node scripts/free-port.mjs 3450 && npm run dev:fresh",
    "check": "npm run check:colors && node scripts/write-app-build-meta.mjs && tsc --noEmit && npm test",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build && node scripts/clean-temp.mjs",
    "lint": "next lint",
    "ship": "bash scripts/deploy-direct.sh",
    "ship:sync": "cd workers/askbible-sync && npx wrangler deploy",
    "pr:auto-merge": "bash scripts/pr-enable-auto-merge.sh",
    "gen:endpoints": "node tools/endpoints-sync.mjs",
    "check:endpoints": "node tools/endpoints-sync.mjs --check",
    "endpoints:push": "node tools/endpoints-sync.mjs --push",
    "check:endpoints:live": "node tools/endpoints-live-check.mjs",
    "gen:medals": "node tools/gen-medals.mjs",
    "check:medals": "node tools/gen-medals.mjs --check",
    "gen:language-order": "node tools/gen-language-order.mjs",
    "check:language-order": "node tools/gen-language-order.mjs --check",
    "check:book-catalog": "node tools/book-catalog-parity.mjs",
    "check:scripture-data": "node tools/scripture-data-check.mjs",
    "check:chapter-audio": "node tools/chapter-audio-check.mjs",
    "build:verse-timings": "node tools/build-verse-timings-db.mjs",
    "check:verse-timings": "node tools/verse-timing-check.mjs",
    "check:reading-plan": "node tools/reading-plan-check.mjs",
    "check:reading-plan-usability": "node tools/reading-plan-usability-check.mjs",
    "gen:explore-articles": "node tools/gen-explore-articles.mjs",
    "check:explore-articles": "node tools/gen-explore-articles.mjs --check",
    "gen:web-pack": "node node_modules/tsx/dist/cli.mjs tools/build-web-pack.mjs",
    "check:web-pack": "node node_modules/tsx/dist/cli.mjs tools/build-web-pack.mjs --check",
    "check:native": "npm run check:endpoints && npm run check:medals && npm run check:language-order && npm run check:book-catalog && npm run check:scripture-data && npm run check:chapter-audio && npm run check:verse-timings && npm run check:reading-plan && npm run check:explore-articles && npm run check:web-pack && npm run check:reading-plan-usability",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build && node scripts/clean-temp.mjs",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "autoprefixer": "^10.4.20",
    "material-icons": "^1.13.14",
    "next": "^15.3.0",
    "opencc-js": "^1.3.1",
    "postcss": "^8.4.49",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vinext/cloudflare": "^1.3.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.32",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5",
    "vite": "^8.3.8",
    "vite-css-modules": "^1.16.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "type": "module"
}
