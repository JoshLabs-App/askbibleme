# Copy to keystore.properties (gitignored) for local Play release signing.
# Upload keystore must match Google Play / EAS upload key.
#
# One-time export from EAS (interactive):
#   cd apps/askbible-mobile && npx eas credentials -p android
#   → Keystore → Download existing keystore
#
MYAPP_UPLOAD_STORE_FILE=upload.keystore
MYAPP_UPLOAD_STORE_PASSWORD=your-store-password
MYAPP_UPLOAD_KEY_ALIAS=your-key-alias
MYAPP_UPLOAD_KEY_PASSWORD=your-key-password
