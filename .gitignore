# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# 构建时由 scripts/write-app-build-meta.mjs 生成（与 data-app-build 对齐）
/public/app-build.json

# production
/build
/dist/mobile/

# Expo 离线 APK 媒体（npm run mobile:sync-offline-media 生成，体积大）
/apps/askbible-mobile/assets/nature/
/apps/askbible-mobile/assets/music/tracks/
/apps/askbible-mobile/assets/music/analysis/

# misc
.DS_Store
.env.local
.env*.local
*.aab
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 由 `npm run build:bible-sqlite` / prebuild 从 uploads JSON 生成（不入库，部署时构建）
/data/bible/sqlite/*.sqlite

# 由 npm run import:reader-verse-themes 从 BIBLE JSON 生成的本地主题库（体积大，不入库）
/data/scripture/reader-verse-themes.sqlite

# 后台 API 密钥（含明文 Key，仅保留 data/admin/ai-api-config.json.example 入仓）
/data/admin/ai-api-config.json

# 潮州语新约 MP3（npm run audio:teochew-pull 生成；manifest 入库）
/public/audio/teochew-nt/*.mp3
/public/audio/web-en/*.mp3

# 本地导入/下载的大体积资源（不入库，避免 Review 卡死）
/data/bible/uploads/
/data/bible/blm-es-chapter-audio-manifest.json
/data/bible/cantonese-v3-audio-manifest.json
/data/bible/cantonese-v3-nt-audio-manifest.json
/data/bible/hakka-audio-manifest.json
/data/bible/open-usfm-chapter-segments.story.zh.json
/public/audio/
/public/verse-timings/
/scripts/whisper-env/

# 本机全本导读/引导版批量进度（见 npm run info-edition:batch）
/data/bible/info-edition-v1-batch-state.json
/data/bible/info-edition-v1-batch.lock
/data/bible/telemetry-v1-store.json
/data/feedback/feedback-submissions.jsonl

# typescript
next-env.d.ts
*.tsbuildinfo

# TV / webOS（本机实验，不部署、不入库）
apps/askbible-tv-webos/
app/(tv)/
components/tv/
lib/media/tv-client.ts
lib/media/tv-shell-boot.ts
scripts/sync-tv-content.mjs
