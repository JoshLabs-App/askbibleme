<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReadingAlarm" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#ECD9B9</item>
    </style>

    <style name="ReadingAlarmPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/reading_alarm_button_primary</item>
        <item name="android:textColor">#1C1410</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="ReadingAlarmSecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/reading_alarm_button_secondary</item>
        <item name="android:textColor">#1C1410</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
</resources>
