  "xp": {
    "_note": "XP 全部由 ledger 现算，不单独存——但每一项都挂在高频动作上，所以读 / 听的时候进度条是肉眼在动的。奖励分三层：① 微反馈（每节、每 15 秒听读），让 XP 每几秒就跳一次；② 里程碑（章 / 卷 / 计划日）给大额，配 +XP 飘字；③ 连续天数乘区（只升不降），让老用户每一次动作都比新用户值钱。听读 XP 受「前台 + 正在播放 + 每章 listenTicksPerChapterCap 片」三重约束，防挂机刷分。",
    "perVerseRead": 8,
    "perListenTick": 12,
    "listenTickSeconds": 15,
    "listenTicksPerChapterCap": 80,
    "perChapterRead": 250,
    "perBookCompleted": 3000,
    "perReadingDay": 400,
    "firstOpenOfDay": 150,
    "perFavorite": 120,
    "perHighlight": 80,
    "perNote": 150,
    "perPlanDay": 500,
    "perMedalTier": 600,
    "perSeal": 1500,
    "streakMultiplier": {
      "_note": "连续 N 天读经，全部 XP 乘 (1 + N × perDay)，封顶 2.5 倍。倍率只升不降（Josh 2026-09-18 拍板 A 方案）：断签后按历史最长连续天数算，爽感保留、「我毁了」去掉。",
      "perDay": 0.05,
      "cap": 2.5
    },
    "combo": {
      "_note": "一次连读同一卷多章：第 2 章起每章额外 +comboStep，封顶 comboCap。鼓励一坐下多读几章。",
      "step": 150,
      "cap": 900
    }
  },
