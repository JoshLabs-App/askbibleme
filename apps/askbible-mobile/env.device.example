# 真机调试：手机访问 Mac 上的 Next（与仓库根目录 npm run dev 同端口）
# 把 192.168.1.20 换成你 Mac 的局域网 IP（ipconfig getifaddr en0）
# Wi‑Fi 真机（手机与 Mac 同网段）：
# EXPO_PUBLIC_ASKBIBLE_BASE_URL=http://192.168.1.20:3450
# EXPO_PUBLIC_ASKBIBLE_DEV_LAN_HOST=192.168.1.20
#
# USB 真机（adb reverse，见 npm run mobile:android:usb）：
EXPO_PUBLIC_ASKBIBLE_BASE_URL=http://127.0.0.1:3450
EXPO_PUBLIC_ASKBIBLE_DEV_USB=1
EXPO_PUBLIC_ASKBIBLE_DEV_LAN_HOST=192.168.1.20

# 测试期间显示读经同步调试条（上架 App Store / Play 正式包请设为 0）
EXPO_PUBLIC_MEMBER_SYNC_DEBUG=1

# Google / Supabase browser OAuth（与根目录 .env.local 保持一致）
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
